  "summary": "FDM可打印双圆形胶囊状翻盖储物盒，带有圆润拱形上盖、底部圆角、打印铰链结构、金属销钉和嵌入式磁铁闭合机构。",
  "required_interfaces": [
    {
      "id": "hinge_pin_fit",
      "kind": "internal_fit",
      "description": "紧凑三节外置铰链必须容纳直径3mm的金属销钉，轴心位于胶囊主体轮廓外，完整开合不得与盒壁干涉；上下盖外壁必须以连续大R截面自然过渡到转轴耳节，不得出现矩形颈部、独立补强块或可见阶梯；转轴孔周、耳根以及销孔内缘到盒体后壁之间不得形成薄壁或细颈",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "magnet_pockets",
      "kind": "internal_fit",
      "description": "上盖和底盒各设置一个居中的磁铁槽，闭合时上下同心，并精确容纳直径6mm、厚度2mm的钕磁铁",
      "source": "user_requested",
      "required": true
    }
  ],
